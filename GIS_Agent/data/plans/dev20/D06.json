{
  "steps": [
    {
      "id": "gas",
      "tool": "query_features",
      "arguments": {
        "layer_name": "gas_pipelines",
        "filters": [
          {
            "field": "code",
            "operator": "eq",
            "value": "G006"
          }
        ]
      },
      "depends_on": []
    },
    {
      "id": "clipped",
      "tool": "clip_features",
      "arguments": {
        "features": {
          "$ref": "gas.result.feature_set"
        },
        "clip_target": {
          "layer_name": "construction_areas",
          "feature_code": "A003"
        }
      },
      "depends_on": [
        "gas"
      ]
    },
    {
      "id": "lengths",
      "tool": "measure_features",
      "arguments": {
        "features": {
          "$ref": "clipped.result.feature_set"
        },
        "measure": "length"
      },
      "depends_on": [
        "clipped"
      ]
    }
  ],
  "outputs": {
    "length": {
      "$ref": "lengths.result.summary"
    }
  }
}
