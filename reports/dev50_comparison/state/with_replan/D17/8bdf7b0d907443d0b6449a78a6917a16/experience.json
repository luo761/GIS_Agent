[
  {
    "task_signature": "gas/空间计算",
    "question_feat": "在gas_devices中筛选与施工区A001相交且状态为正常或告警的设备，对筛选结果缓冲300米并合并，再用该合并几何裁剪到A001范围，得到覆盖几何。基于该覆盖几何，分别计算其面积（平方米）和其中全部gas_pipelines的总长度（米），保留非空且长度大于0的接触记录。",
    "plan": {
      "t1": {
        "nodes": [
          {
            "id": "s1",
            "action": "query_features",
            "params": {
              "table": "gas_devices",
              "filters": {
                "status": [
                  "正常",
                  "告警"
                ],
                "spatial": {
                  "relation": "intersects",
                  "with": "construction_areas",
                  "code": "A001"
                }
              }
            },
            "depends_on": []
          },
          {
            "id": "s2",
            "action": "buffer_features",
            "params": {
              "distance": 300,
              "unit": "meter"
            },
            "depends_on": [
              "s1"
            ]
          },
          {
            "id": "s3",
            "action": "union_features",
            "params": {},
            "depends_on": [
              "s2"
            ]
          },
          {
            "id": "s4",
            "action": "clip_features",
            "params": {
              "clip_layer": "construction_areas",
              "code": "A001"
            },
            "depends_on": [
              "s3"
            ]
          },
          {
            "id": "s5",
            "action": "measure_features",
            "params": {
              "measure": "area",
              "unit": "square_meter"
            },
            "depends_on": [
              "s4"
            ]
          },
          {
            "id": "s6",
            "action": "query_features",
            "params": {
              "table": "gas_pipelines",
              "filters": {
                "spatial": {
                  "relation": "intersects",
                  "with": "s4_result"
                }
              }
            },
            "depends_on": [
              "s4"
            ]
          },
          {
