              "unit": "meter"
            },
            "depends_on": [
              "s1"
            ]
          },
          {
            "id": "s3",
            "action": "union_features",
            "params": {},
            "depends_on": [
              "s2"
            ]
          },
          {
            "id": "s4",
            "action": "clip_features",
            "params": {
              "clip_layer": {
