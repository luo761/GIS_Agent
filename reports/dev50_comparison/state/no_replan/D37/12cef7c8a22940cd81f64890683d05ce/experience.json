              "geometry_field": "geom"
            },
            "depends_on": []
          },
          {
            "id": "s2",
            "action": "buffer_geometry",
            "params": {
              "distance": 100,
              "units": "meters"
            },
            "depends_on": [
              "s1"
            ]
          },
          {
            "id": "s3",
            "action": "query_features",
            "params": {
              "table": "gas_devices",
              "geometry_field": "geom"
            },
            "depends_on": []
          },
          {
            "id": "s4",
            "action": "intersection_geometry",
            "params": {
              "method": "ST_Intersects",
              "include_boundary": true
            },
            "depends_on": [
