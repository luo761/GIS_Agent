[
  {
    "task_signature": "gas/空间计算",
    "question_feat": "在 gas_pipelines 表中，筛选与面要素 A001 相交（ST_Intersects）的燃气管线，裁剪到 A001 范围内，逐条计算裁剪后管线长度（米），保留非空零长度接触记录；汇总全部管线长度总和、其中 pressure_level='高压' 的管线长度总和，并计算高压长度占全部长度的百分比。",
    "plan": {
      "t1": {
        "nodes": [
          {
            "id": "s1",
            "action": "query_features",
            "params": {
              "table": "gas_pipelines",
              "filters": {
                "geom": "ST_Intersects(geom, (SELECT geom FROM construction_areas WHERE code='A001'))"
              }
            },
            "depends_on": []
          },
          {
            "id": "s2",
            "action": "clip_features",
            "params": {
              "input": "s1",
              "clip_polygon": "A001",
              "keep_boundary_touch": true
            },
            "depends_on": [
              "s1"
            ]
          },
          {
            "id": "s3",
            "action": "measure_features",
            "params": {
              "input": "s2",
              "unit": "meter",
              "keep_zero_length": true
            },
            "depends_on": [
              "s2"
            ]
          },
          {
            "id": "s4",
            "action": "summarize_features",
            "params": {
              "input": "s3",
              "aggregate": "sum",
              "field": "length",
              "group_by": null
            },
            "depends_on": [
              "s3"
            ]
          },
          {
            "id": "s5",
            "action": "summarize_features",
            "params": {
              "input": "s3",
              "aggregate": "sum",
              "field": "length",
              "group_by": "pressure_level",
              "filter": "pressure_level='高压'"
            },
            "depends_on": [
              "s3"
            ]
          },
          {
            "id": "s6",
            "action": "calculate_ratio",
            "params": {
              "numerator": "s5",
              "denominator": "s4",
              "output": "percentage"
            },
            "depends_on": [
              "s4",
              "s5"
            ]
          }
        ],
        "edges": [
          [
            "s1",
            "s2"
          ],
          [
            "s2",
            "s3"
          ],
          [
            "s3",
            "s4"
          ],
          [
            "s3",
            "s5"
          ],
          [
            "s4",
            "s6"
          ],
          [
            "s5",
            "s6"
          ]
        ]
      }
    },
    "trace": "在 gas_pipelines 表中筛选与 A001 相交的燃气管线，裁剪至 A001 范围后逐条计算长度。调用顺序：query_features(ST_Intersects)→clip_features→measure_features(length)→summarize_features(aggregate=sum)→summarize_features(group_by=['pressure_level'])→calculate_ratio。结果：共6条管线，总长5814.21米，高压长度2414.21米，高压占比41.52%。",
    "outcome": "success",
