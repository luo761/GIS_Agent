[
  {
    "task_signature": "water/空间计算",
    "question_feat": "在EPSG:3857坐标系下，从water_pipelines表中筛选与construction_areas中code='A003'的施工区相交的水管，裁剪到A003实体部分（排除孔洞），保留非空裁剪结果；对每条裁剪结果建立25米缓冲区并合并去重，计算最终面积（平方米）。",
    "plan": {
      "t1": {
        "nodes": [
          {
            "id": "s1",
            "action": "query_features",
            "params": {
              "table": "construction_areas",
              "where": "code = 'A003'"
            },
            "depends_on": []
          },
          {
            "id": "s2",
            "action": "query_features",
            "params": {
              "table": "water_pipelines",
              "where": "ST_Intersects(geom, (SELECT geom FROM construction_areas WHERE code = 'A003'))"
            },
            "depends_on": [
              "s1"
            ]
          },
          {
            "id": "s3",
            "action": "clip_features",
            "params": {
              "input": "s2",
              "clipper": "s1",
              "exclude_holes": true
            },
            "depends_on": [
              "s1",
              "s2"
            ]
          },
          {
            "id": "s4",
            "action": "filter_non_empty",
            "params": {
              "input": "s3"
            },
            "depends_on": [
              "s3"
            ]
          },
          {
            "id": "s5",
            "action": "buffer_features",
            "params": {
              "input": "s4",
              "distance": 25,
              "unit": "meter"
            },
            "depends_on": [
              "s4"
            ]
          },
          {
            "id": "s6",
            "action": "union_features",
            "params": {
              "input": "s5"
            },
            "depends_on": [
              "s5"
            ]
          },
          {
            "id": "s7",
            "action": "measure_geometry",
            "params": {
              "input": "s6",
              "measure": "area",
              "unit": "square_meter"
            },
            "depends_on": [
              "s6"
            ]
          }
        ],
        "edges": [
          [
            "s1",
            "s2"
          ],
          [
            "s1",
            "s3"
          ],
          [
            "s2",
            "s3"
          ],
          [
            "s3",
            "s4"
          ],
          [
            "s4",
            "s5"
          ],
          [
            "s5",
            "s6"
          ],
          [
            "s6",
            "s7"
          ]
        ]
      }
    },
    "trace": "在EPSG:3857下，查询施工区A003（1个）及相交水管（3条），裁剪至A003实体并排除孔洞（3条非空），对每条建立25米缓冲区后合并去重，最终计算面积。关键调用：query_features→clip_features→buffer_features(25m)→union_features→measure_geometry(area)，结果面积40852.71平方米。",
