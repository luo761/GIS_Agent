[
  {
    "task_signature": "gas/空间计算",
    "question_feat": "在 gas_pipelines 表中，筛选与施工区 A001 相交（ST_Intersects，含边界接触）的燃气管线，将其裁剪到 A001 范围内，按 pressure_level 分组汇总裁剪后线段的长度（米），结果按总长度降序、压力等级名称升序排列，输出全部分组。",
    "plan": {
      "t1": {
        "nodes": [
          {
            "id": "s1",
            "action": "query_features",
            "params": {
              "table": "gas_pipelines",
              "filter": "ST_Intersects(geom, (SELECT geom FROM construction_areas WHERE code='A001'))"
            },
            "depends_on": []
          },
          {
            "id": "s2",
            "action": "clip_features",
            "params": {
              "input": "s1",
              "clip_polygon": "construction_areas.code='A001'",
              "keep_boundary": true
            },
            "depends_on": [
              "s1"
            ]
          },
          {
            "id": "s3",
            "action": "measure_features",
            "params": {
              "input": "s2",
              "measure": "length",
              "unit": "meter",
              "srid": 3857
            },
            "depends_on": [
              "s2"
            ]
          },
          {
            "id": "s4",
            "action": "summarize_features",
            "params": {
              "input": "s3",
              "aggregate": "sum",
              "group_by": "pressure_level",
              "sort": [
                {
                  "field": "total_length",
                  "order": "desc"
                },
                {
                  "field": "pressure_level",
                  "order": "asc"
                }
              ]
            },
            "depends_on": [
              "s3"
            ]
          }
        ],
        "edges": [
          [
            "s1",
            "s2"
          ],
          [
            "s2",
            "s3"
          ],
          [
            "s3",
            "s4"
          ]
        ]
      }
    },
    "trace": "在 gas_pipelines 表中，筛选与施工区 A001 相交（ST_Intersects）的燃气管线，裁剪到 A001 范围内，按 pressure_level 分组汇总裁剪后线段长度（米），结果按总长度降序、压力等级名称升序排列，输出全部分组。调用顺序：query_features（相交筛选，6条）→ clip_features（裁剪，6条）→ measure_features（长度测量，总长5814.21米）→ summarize_features（按pressure_level分组求和，3组）。",
