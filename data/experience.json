  {
    "task_signature": "gas/综合",
    "question_feat": "从 gas_pipelines 中筛选 pressure_level='高压' 且与施工区 construction_areas.code='A001' 相交的燃气管线，裁剪至 A001 边界后分别缓冲 50 米并合并为同一影响范围；复用该范围：(1) 统计 A001 内 gas_devices 中 status 为 '正常' 或 '告警' 的设备，按 status 升序分组计数；(2) 计算 A001 内 water_pipelines 各管线的受影响长度（米），按长度降序、同长按 code 升序输出，并给出总长度；边界计入，非空零长度接触记录保留。",
    "plan": {
      "t1": {
        "nodes": [
          {
            "id": "s1",
            "action": "query_features",
            "params": {
              "table": "construction_areas",
              "where": "code = 'A001'",
              "select": "geom"
            },
            "depends_on": []
          },
          {
            "id": "s2",
            "action": "query_features",
            "params": {
              "table": "gas_pipelines",
              "where": "pressure_level = '高压'",
              "select": "id, code, geom"
            },
            "depends_on": []
          },
          {
            "id": "s3",
            "action": "intersection_geometry",
            "params": {
              "left": "s2",
              "right": "s1",
              "predicate": "ST_Intersects",
              "include_boundary": true
            },
            "depends_on": [
              "s1",
              "s2"
            ]
          },
          {
            "id": "s4",
            "action": "clip_features",
            "params": {
              "input": "s3",
              "clip_geom": "s1"
            },
            "depends_on": [
              "s3",
              "s1"
            ]
          },
          {
            "id": "s5",
            "action": "buffer_features",
            "params": {
              "input": "s4",
              "distance": 50,
              "unit": "meter"
            },
            "depends_on": [
              "s4"
            ]
          },
          {
            "id": "s6",
            "action": "union_features",
            "params": {
              "input": "s5",
              "dissolve": true
            },
            "depends_on": [
              "s5"
            ]
          },
          {
            "id": "s7",
            "action": "query_features",
            "params": {
              "table": "gas_devices",
              "where": "status IN ('正常','告警')",
              "select": "id, code, status, geom"
            },
            "depends_on": []
          },
          {
            "id": "s8",
            "action": "intersection_geometry",
            "params": {
              "left": "s7",
              "right": "s1",
              "predicate": "ST_Intersects",
              "include_boundary": true
            },
            "depends_on": [
              "s7",
              "s1"
            ]
          },
          {
            "id": "s9",
            "action": "summarize_features",
            "params": {
              "input": "s8",
              "aggregate": "count",
              "group_by": "status",
              "sort": "status ASC",
              "output": "status, count"
            },
            "depends_on": [
              "s8"
            ]
          },
          {
            "id": "s10",
            "action": "query_features",
            "params": {
              "table": "water_pipelines",
              "select": "id, code, geom"
            },
            "depends_on": []
          },
          {
            "id": "s11",
            "action": "intersection_geometry",
            "params": {
              "left": "s10",
              "right": "s6",
              "predicate": "ST_Intersects",
              "include_boundary": true
            },
            "depends_on": [
              "s10",
              "s6"
            ]
          },
          {
            "id": "s12",
            "action": "intersection_geometry",
            "params": {
              "left": "s11",
              "right": "s1",
              "predicate": "ST_Intersects",
              "include_boundary": true
            },
            "depends_on": [
              "s11",
              "s1"
            ]
          },
          {
            "id": "s13",
            "action": "clip_features",
            "params": {
              "input": "s12",
              "clip_geom": "s6"
            },
            "depends_on": [
              "s12",
              "s6"
            ]
          },
          {
            "id": "s14",
            "action": "measure_features",
            "params": {
              "input": "s13",
              "measure": "length",
              "unit": "meter",
              "keep_zero_length_nonempty": true,
              "output": "code, length_m"
            },
            "depends_on": [
              "s13"
            ]
          },
          {
            "id": "s15",
            "action": "summarize_features",
            "params": {
              "input": "s14",
              "aggregate": "sum",
              "group_by": "code",
              "value_field": "length_m",
              "sort": "length_m DESC, code ASC",
              "output": "code, length_m"
            },
            "depends_on": [
              "s14"
            ]
          },
          {
            "id": "s16",
            "action": "summarize_features",
            "params": {
              "input": "s14",
              "aggregate": "sum",
              "value_field": "length_m",
              "output": "total_length_m"
            },
            "depends_on": [
              "s14"
            ]
          }
        ],
        "edges": [
          [
            "s1",
            "s3"
          ],
          [
