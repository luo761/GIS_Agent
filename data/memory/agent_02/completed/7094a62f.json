{
  "id": "7094a62f",
  "agent_id": "agent_02",
  "question_feat": "在 gas_devices 中筛选与施工区 A001 相交且 status 为'正常'或'告警'的设备，对其 geom 分别按 300 米缓冲，合并（union）去重后裁剪（clip）到 A001 的几何范围，得到覆盖几何；复用该覆盖几何分别计算覆盖面积（平方米）以及其中 gas_pipelines 全部燃气管线的总长度（米），保留非空零长度接触记录。",
  "plan": {
    "nodes": [
      {
        "id": "s1",
        "action": "query_features",
        "params": {
          "table": "construction_areas",
          "filter": "code = 'A001'",
          "select": [
            "code",
            "geom"
          ]
        },
        "depends_on": []
      },
      {
        "id": "s2",
        "action": "query_features",
        "params": {
          "table": "gas_devices",
          "filter": "status IN ('正常','告警')",
          "select": [
            "code",
            "status",
            "geom"
          ]
        },
        "depends_on": []
      },
      {
        "id": "s3",
        "action": "intersection_geometry",
        "params": {
          "left": "s2",
          "right": "s1",
          "predicate": "ST_Intersects",
          "boundary_touch": true,
          "output": "devices_intersecting_A001"
        },
        "depends_on": [
          "s1",
          "s2"
        ]
      },
      {
        "id": "s4",
        "action": "buffer_features",
        "params": {
          "input": "s3",
          "distance": 300,
          "unit": "meter",
          "per_feature": true,
          "dissolve": false
        },
        "depends_on": [
          "s3"
        ]
      },
      {
        "id": "s5",
        "action": "union_features",
        "params": {
          "input": "s4",
          "dissolve": true,
          "output": "union_buffers"
        },
        "depends_on": [
          "s4"
        ]
      },
      {
        "id": "s6",
        "action": "clip_features",
        "params": {
          "input": "s5",
          "clip_geometry": "s1.geom",
          "output": "coverage_geom"
        },
        "depends_on": [
          "s5",
          "s1"
        ]
      },
      {
        "id": "s7",
        "action": "measure_features",
        "params": {
          "input": "s6",
          "measure": "area",
          "unit": "square_meter",
          "output": "coverage_area"
        },
        "depends_on": [
          "s6"
        ]
      },
      {
        "id": "s8",
        "action": "query_features",
        "params": {
          "table": "gas_pipelines",
          "filter": "1=1",
          "select": [
            "code",
            "geom"
          ]
        },
        "depends_on": []
      },
      {
        "id": "s9",
        "action": "clip_features",
        "params": {
          "input": "s8",
          "clip_geometry": "s6",
          "output": "pipelines_in_coverage",
          "keep_empty_zero_length_touch": true
        },
        "depends_on": [
          "s8",
          "s6"
        ]
      },
      {
        "id": "s10",
        "action": "measure_features",
        "params": {
          "input": "s9",
          "measure": "length",
          "unit": "meter",
          "output": "total_pipeline_length",
          "keep_zero_length_touch": true
        },
        "depends_on": [
          "s9"
        ]
